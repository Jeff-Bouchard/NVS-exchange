+    public function processAuthorizedSlot(string $slot_id): bool
+    {
+        $slot = $this->db->getSlot($slot_id);
+        if (empty($slot)) {
+            throw new \RuntimeException('Slot not found');
+        }
+        if ('PAYED' === $slot['status']) {
+            return true;
+        }
+        if ('GENERATED' !== $slot['status'] && 'UPDATED' !== $slot['status']) {
+            throw new \RuntimeException('Slot is not payable');
+        }
+
+        $addrs = json_decode($slot['addr'], true);
+        if (empty($addrs) || empty($addrs['EMC']['days'])) {
+            throw new \RuntimeException('Slot lacks an Emercoin quote');
+        }
+        $days = (int) $addrs['EMC']['days'];
+        $isBatch = strpos($slot['name'], 'batch:') === 0;
+        if ($isBatch) {
+            $doc = new \DOMDocument();
+            if (!$doc->loadXML($slot['value'], LIBXML_NONET | LIBXML_NOBLANKS) ||
+                $doc->documentElement->tagName !== 'nameBatch') {
+                throw new \RuntimeException('Invalid stored nameBatch');
+            }
+            $records = [];
+            foreach ($doc->documentElement->getElementsByTagName('record') as $record) {
+                $valueNode = $record->getElementsByTagName('value')->item(0);
+                $records[$record->getAttribute('name')] = [
+                    'value' => $valueNode->textContent,
+                    'days' => (int) $record->getAttribute('days')
+                ];
+            }
+            Emercoin::names_new($records, $days, $slot['address']);
+        } elseif ('UPDATED' === $slot['status']) {
+            Emercoin::name_update($slot['name'], $slot['value'], $days, $slot['address']);
+        } elseif (!empty($slot['address'])) {
+            Emercoin::name_new($slot['name'], $slot['value'], $days, $slot['address']);
+        } else {
+            Emercoin::name_new($slot['name'], $slot['value'], $days);
+        }
+
+        $this->db->setSlotPayed($slot_id);
+        return true;
+    }
